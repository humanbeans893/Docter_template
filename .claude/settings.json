{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(bash draft/compile.sh:*)",
      "Bash(python3 tools/thesis_check.py:*)",
      "Bash(python3 tools/public_repo_check.py:*)",
      "Bash(python3 tools/archive_thesis.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(external/**)",
      "Write(external/**)",
      "Bash(python *)",
      "Bash(python3 -m venv*)",
      "Bash(python3 -m pip*)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(virtualenv *)",
      "Bash(uv *)"
    ]
  }
}
