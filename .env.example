# Machine-local settings for docker compose. Copy to `.env` (gitignored) and
# adjust per machine. Secrets also belong in `.env`, never in tracked files.

# Host user/group IDs used inside the container so generated files stay owned
# by you. `id -u` / `id -g` print them (defaults cover the common 1000:1000).
#UID=1000
#GID=1000

# GPU and the read-only /external mount: list the override files once here, so that every
# docker compose and make command keeps them (a one-off -f is lost on the next make up).
# After changing COMPOSE_FILE, check for running jobs, then run make up.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.files.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.files.yml

# Optional read-only directory synchronized by Google Drive, Dropbox, OneDrive,
# Nextcloud, or another file application. Use an absolute host path. Enable it
# when COMPOSE_FILE lists docker-compose.files.yml (then EXTERNAL_FILES_DIR is required, as an absolute host path); never point it at a directory containing credentials.
#EXTERNAL_FILES_DIR=/absolute/path/to/synced/research-files
