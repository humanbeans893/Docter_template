# latexmk configuration for the dissertation (LuaLaTeX + BibTeX/natbib).
# Usage:  cd draft && latexmk        # build main.tex -> main.pdf (or: make pdf)
#         latexmk supplementary.tex  # build the standalone supplementary doc
#         latexmk -c                 # clean auxiliary files (keep the PDF)
#         latexmk -C                 # clean everything including the PDF
$pdf_mode = 4;    # 4 = lualatex
$lualatex = 'lualatex -interaction=nonstopmode -file-line-error -synctex=1 %O %S';
$bibtex_use = 2;  # run bibtex when needed; -C also removes the .bbl
$max_repeat = 5;
@default_files = ('main.tex');
# nonstopmode without -halt-on-error: one run accumulates every problem in
# main.log so tools/thesis_check.py can report them all at once; latexmk still
# exits nonzero while errors remain.
