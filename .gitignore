# ============================
# Per-study raw / high-volume research data
# ============================
projects/**/data/raw/**
!projects/**/data/raw/
!projects/**/data/raw/**/
!projects/**/data/raw/**/.gitkeep
projects/**/data/interim/**
!projects/**/data/interim/
!projects/**/data/interim/.gitkeep
projects/**/data/processed/**
!projects/**/data/processed/
!projects/**/data/processed/.gitkeep

# Optional project-specific data locations
/raw/
/datasets/
/input/
/outputs/large/

# ============================
# Large file extensions
# ============================
*.nc
*.h5
*.hdf
*.hdf5
*.pkl
*.pickle
*.model
*.weights
*.pt
*.pth
*.ckpt
*.pxp
*.wch
*.bin
*.tar
*.gz
*.zip
*.7z
*.parquet

# ============================
# Python cache / compiled
# ============================
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================
# Local dev caches
# ============================
.cache/
.local/
.pytest_cache/
.ruff_cache/

# ============================
# Heavy result artifacts
# ============================
projects/**/result/**/animations/**
!projects/**/result/**/animations/
!projects/**/result/**/animations/.gitkeep

# ============================
# Jupyter Notebook checkpoints
# ============================
.ipynb_checkpoints/

# ============================
# Environments
# ============================
.env
.venv
env/
venv/

# ============================
# IDE files
# ============================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================
# OS files
# ============================
.DS_Store
Thumbs.db

# ============================
# Logs and local settings
# ============================
*.log
.claude/settings.local.json
.claude/sessions/
.mcp.json

# External application state and literature attachments
.external/
external/
zotero.sqlite*
*.enl
*.data/
references/attachments/
references/library/

# ============================
# Per-user shared memory
# ============================
memory

# ============================
# LaTeX build artifacts (root and \include subdirectories)
# ============================
draft/**/*.aux
draft/**/*.bbl
draft/**/*.blg
draft/**/*.out
draft/**/*.pdf
draft/**/*.fls
draft/**/*.fdb_latexmk
draft/**/*.synctex.gz
draft/**/*.toc
draft/**/*.lof
draft/**/*.lot
draft/**/*.tdo
