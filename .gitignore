# ============================
# Large file extensions (data belongs to the research repositories, never to the thesis)
# ============================
*.nc
*.h5
*.hdf
*.hdf5
*.pkl
*.pickle
*.model
*.weights
*.pt
*.pth
*.ckpt
*.pxp
*.wch
*.bin
*.tar
*.gz
*.zip
*.7z
*.parquet

# ============================
# Python cache / compiled
# ============================
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================
# Local dev caches
# ============================
.cache/
.local/
.pytest_cache/
.ruff_cache/

# ============================
# Environments
# ============================
.env
.venv
env/
venv/

# ============================
# IDE files
# ============================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================
# OS files
# ============================
.DS_Store
._*
Thumbs.db

# ============================
# Logs and local settings
# ============================
*.log
.claude/settings.local.json
.claude/sessions/
.claude/worktrees/
# Local MCP client settings and Codex project settings can carry API keys and other secrets.
.mcp.json
.codex/config.toml

# Archived submissions (make archive TAG=...): PDFs, source.tar and manifests per tag.
/dist/

# external/<repo>: optional local links to the research repositories (read-only). What the
# thesis uses is copied into projects/<id>/; external/ is never committed (make security fails
# on it). No trailing slash: external may itself be a symlink.
/external

# External application state
.external/
zotero.sqlite*
*.enl
*.data/

# ============================
# Per-user shared memory
# ============================
/memory

# ============================
# LaTeX build artifacts
# ============================
# draft/compile.sh writes every intermediate to draft/build/ and moves only the PDFs back into
# draft/. Hand-made figures in draft/figures/ (PDF included) stay committable.
draft/build/
draft/*.pdf
# Safety net for a lualatex run inside draft/ (make clean-tex removes these files).
draft/**/*.aux
draft/**/*.bbl
draft/**/*.blg
draft/**/*.out
draft/**/*.fls
draft/**/*.fdb_latexmk
draft/**/*.synctex.gz
draft/**/*.toc
draft/**/*.lof
draft/**/*.lot
draft/**/*.tdo
