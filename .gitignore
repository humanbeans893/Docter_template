# ============================
# Per-study raw / high-volume research data
# ============================
projects/**/data/raw/**
!projects/**/data/raw/
!projects/**/data/raw/**/
!projects/**/data/raw/**/.gitkeep
projects/**/data/interim/**
!projects/**/data/interim/
!projects/**/data/interim/.gitkeep
projects/**/data/processed/**
!projects/**/data/processed/
!projects/**/data/processed/.gitkeep

# ============================
# Experiment outputs (projects/<study>/experiments/NNN_<slug>/out/: the run record, staged/ and smoke/)
# ============================
# Scratch output of each run; what the thesis uses reaches result/ when a full run completes.
projects/*/experiments/*/out/**
!projects/*/experiments/*/out/
!projects/*/experiments/*/out/.gitkeep

# Optional project-specific data locations
/raw/
/datasets/
/input/
/outputs/large/

# ============================
# Large file extensions
# ============================
*.nc
*.h5
*.hdf
*.hdf5
*.pkl
*.pickle
*.model
*.weights
*.pt
*.pth
*.ckpt
*.pxp
*.wch
*.bin
*.tar
*.gz
*.zip
*.7z
*.parquet

# ============================
# Python cache / compiled
# ============================
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================
# Local dev caches
# ============================
.cache/
.local/
.pytest_cache/
.ruff_cache/

# ============================
# Heavy result artifacts
# ============================
projects/**/result/**/animations/**
!projects/**/result/**/animations/
!projects/**/result/**/animations/.gitkeep

# ============================
# Environments
# ============================
.env
.venv
env/
venv/

# ============================
# IDE files
# ============================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================
# OS files
# ============================
.DS_Store
._*
Thumbs.db

# ============================
# Logs and local settings
# ============================
*.log
.claude/settings.local.json
.claude/sessions/
.claude/worktrees/
# Local MCP client settings and Codex project settings can carry API keys and other secrets.
.mcp.json
.codex/config.toml

# Archived submissions (make archive TAG=...): PDFs, source.tar and manifests per tag.
/dist/

# External application state and literature attachments
.external/
external/
zotero.sqlite*
*.enl
*.data/
references/attachments/
references/library/

# ============================
# Per-user shared memory
# ============================
/memory

# ============================
# LaTeX build artifacts
# ============================
# draft/compile.sh writes every intermediate to draft/build/ and moves only the PDFs back into
# draft/. Hand-made figures in draft/figures/ (PDF included) stay committable.
draft/build/
draft/*.pdf
# Safety net for a lualatex run inside draft/ (make clean-tex removes these files).
draft/**/*.aux
draft/**/*.bbl
draft/**/*.blg
draft/**/*.out
draft/**/*.fls
draft/**/*.fdb_latexmk
draft/**/*.synctex.gz
draft/**/*.toc
draft/**/*.lof
draft/**/*.lot
draft/**/*.tdo
